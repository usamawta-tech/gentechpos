DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Change this in production (min 32 chars).
AUTH_SECRET=""

# Optional SMTP for emailing receipts. If left blank, a temporary Ethereal
# test inbox is used and a preview link is returned instead of real delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GenTech <no-reply@gentech.local>"
